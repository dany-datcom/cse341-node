  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "email": {
            "type": "string",
            "example": "dany@email.com"
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "TaskFlow API"
          },
          "description": {
            "type": "string",
            "example": "Final project for CSE 341"
          },
          "status": {
            "type": "string",
            "example": "In Progress"
          }
        }
      }
      ,
      "Task": {
        "type": "object",
        "required": [
          "title",
          "description",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Create API Routes"
          },
          "description": {
            "type": "string",
            "example": "Build CRUD endpoints for tasks"
          },
          "status": {
            "type": "string",
            "example": "In Progress"
          }
        }
      },
      "Team": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Development Team"
          }
        }
      }

    }
  }
}