  "components": {
    "securitySchemes": {
      "githubAuth": {
        "type": "oauth2",
        "description": "GitHub OAuth Authentication",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://github.com/login/oauth/authorize",
            "tokenUrl": "https://github.com/login/oauth/access_token",
            "scopes": {
              "user:email": "Access email address"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd1"
          },
          "name": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "email": {
            "type": "string",
            "example": "dany@email.com"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "manager", "member", "guest"],
            "example": "admin"
          },
          "phone": {
            "type": "string",
            "example": "88888888"
          },
          "department": {
            "type": "string",
            "example": "IT"
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "example": "Active"
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-15"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "role",
          "phone",
          "department",
          "status",
          "joinDate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "dany@email.com"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "manager", "member", "guest"],
            "example": "admin"
          },
          "phone": {
            "type": "string",
            "example": "88888888"
          },
          "department": {
            "type": "string",
            "example": "IT"
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "example": "Active"
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-15"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd2"
          },
          "title": {
            "type": "string",
            "example": "TaskFlow API"
          },
          "description": {
            "type": "string",
            "example": "Final project for CSE 341"
          },
          "status": {
            "type": "string",
            "enum": ["Not Started", "In Progress", "Completed"],
            "example": "In Progress"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "owner": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "budget": {
            "type": "number",
            "example": 5000
          }
        }
      },
      "ProjectInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "status",
          "startDate",
          "endDate",
          "owner",
          "budget"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "TaskFlow API"
          },
          "description": {
            "type": "string",
            "example": "Final project for CSE 341"
          },
          "status": {
            "type": "string",
            "enum": ["Not Started", "In Progress", "Completed"],
            "example": "In Progress"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2026-07-01"
          },
          "owner": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "budget": {
            "type": "number",
            "example": 5000
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd3"
          },
          "title": {
            "type": "string",
            "example": "Build CRUD endpoints"
          },
          "description": {
            "type": "string",
            "example": "Implement GET POST PUT DELETE routes"
          },
          "status": {
            "type": "string",
            "enum": ["Not Started", "In Progress", "Completed"],
            "example": "In Progress"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "example": "High"
          },
          "assignedTo": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-30"
          },
          "projectId": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd2"
          }
        }
      },
      "TaskInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "status",
          "priority",
          "assignedTo",
          "dueDate",
          "projectId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Build CRUD endpoints"
          },
          "description": {
            "type": "string",
            "example": "Implement GET POST PUT DELETE routes"
          },
          "status": {
            "type": "string",
            "enum": ["Not Started", "In Progress", "Completed"],
            "example": "In Progress"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "example": "High"
          },
          "assignedTo": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-06-30"
          },
          "projectId": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd2"
          }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "684f7c5d2e123456789abcd4"
          },
          "name": {
            "type": "string",
            "example": "Development Team"
          },
          "description": {
            "type": "string",
            "example": "Main software development team"
          },
          "teamLead": {
            "type": "string",
            "example": "Dany Jimenez"
          },
          "memberCount": {
            "type": "integer",
            "example": 5
          },
