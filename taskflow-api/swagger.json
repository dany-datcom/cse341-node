  "paths": {
    "/auth/github": {
      "get": {
        "summary": "Login with GitHub",
        "description": "Redirects to GitHub OAuth authentication page",
        "tags": ["Authentication"],
        "responses": {
          "302": {
            "description": "Redirects user to GitHub authentication"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "summary": "GitHub OAuth Callback",
        "description": "GitHub redirects here after authentication",
        "tags": ["Authentication"],
        "responses": {
          "302": {
            "description": "Redirects to API documentation on success"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "summary": "Logout current user",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "User logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Logged out"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "summary": "Authentication failure",
        "tags": ["Authentication"],
        "responses": {
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Authentication failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
